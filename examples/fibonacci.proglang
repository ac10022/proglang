import convert;

// just for convenience, when the time comes we make a very user friendly string struct maybe
import string;

fn fib(u32 n) {
    if (n == 0) return 1;
    if (n == 1) return 1;
    return fib(n-1) + fib(n-2);
}

fn main(i32 argc, u8** argv) {
    string input = input("pick n for fib(n)");
    u32 n = s_to_u32(input);
    u32 res = fib(n);
    print(res);
}
