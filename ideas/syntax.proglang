// function declaration            v return type
fn fun_name(i32 arg1, u8 arg2) -> i32 { return; }

// variable declaration
u32 var = 0;
var = 32;           // <- assignment, must be first declared

// structs (TODO)

// imports
import lib_name;

// block statements (new scope)
{
    u32 temp = 0;
}

// conditional statements
if (condition) {

} else if (condition2) {

} else {

}

// looping statements
// for (init; while; post)

for (u32 i = 0; i < 10; i++) {

}

while (var < 100) {

}

// i think this would be quite nice to have
for (u32 i in 1..100) { // like shell syntax kinda
    // this would just translate to for (u32 i = 1; i <= 100; i++)
}

// jump statements
fn example(void) -> void {

    while (true) {
        if (true) {
            break;
        }

        if (false) {
            continue;
        }
    }

    return;
}

// expression statements
example(); // calling the example function
u32 i = add(1, 2);

// literals
u32 integer = 42;
f32 float = 3.14;
u8 hex = 0xFF;
u16 octal = 020;

char* str1 = "Hello, world!\n";
// char will just be typedef u8
char c = 'a';

b8 bool1 = true;
b8 bool2 = false;

// pointers are the part which confuse me really
// i think we should avoid NULL in our language

// one idea is we can copy from zig where they do optional pointers
i32 x = 10;
i32* pointer = &x;
i32*? optional_pointer = null; // only these optinal pointer types may be null

// variable and function names
// must start with '_' or an alphabetic character, but any '_' or alnum character after that

i32 _var = 10; // ok
i32 2var = 10; // bad
i32 var2 = 10; // ok
i32 ______var______ = 10; // ok

// operator presedence (lowest to highest)

// name                                 symbols                 examples
// Assignment	                        =, +=, -=, *=, /=	    x = y + 2
// Logical OR	                        ||	                    a || b
// Logical AND	                        &&	                    a && b
// Equality	                            ==, !=	                status == 200
// Comparison	                        <, >, <=, >=	        age >= 18
// Term (Additive)	                    +, -	                income - tax
// Factor (Multiplicative)	            *, /, %	                hours * wage
// Unary / Prefix	                    !, ++, --	            !is_active, count--
// Postfix / Call	                    (), [], ., ->	        matrix[i][j]
// Identifiers, Literals, Grouping	                            x, 42, "hello", (a + b)