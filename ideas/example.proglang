// which one?
// c-like
// int32 main(int32 argc, string[] argv)

// or rust like
// fn main(int32 argc, string[] argv) -> int32
// ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^ this one asserts dominance imo (yehor)

// or python like
